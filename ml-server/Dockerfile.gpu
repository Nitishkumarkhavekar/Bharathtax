# GPU image for ml-server (bge-m3 + bge-reranker on CUDA 12.8 / Blackwell sm_120).
# Build:  docker compose -f docker-compose.ml.yml up -d --build
# Requires nvidia-container-toolkit on the host + a GPU reservation in compose.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.gpu.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.gpu.txt

COPY app.py ./

EXPOSE 8001
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001"]
