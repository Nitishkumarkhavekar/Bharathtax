# env / secrets
.env
*.env.local
.secrets/
**/.secrets/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# node / frontend
node_modules/
dist/
.vite/

# data: keep folder structure, ignore contents (source files are large/external)
data/manual/**
!data/manual/.gitkeep
!data/manual/**/.gitkeep
data/cache/**
!data/cache/.gitkeep
# built vector store + large media (belongs in LFS/external, not git)
data/corpus_dataset/
*.npy
*.m4a

# electron-builder tool cache (downloadable build binaries — never commit)
desktop/.ebcache/

# misc
.DS_Store
*.log

# handover artifacts (large DB dump kept out of git; ship separately)
handover/

# local QA / persona test corpora — real user documents, not for git
25-Sale Deed/
test_questions/

# celery beat runtime state (regenerated; never commit)
backend/celerybeat-schedule*

# Service-account keys / local secrets (NEVER commit)
backend/secrets/
backend/app/secrets/
secrets/
**/vertex*.json
**/service-account*.json
gen-lang-client-*.json
*-service-account*.json
