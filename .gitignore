# env / secrets
.env
*.env.local

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# node / frontend
node_modules/
dist/
.vite/

# data: keep folder structure, ignore contents (source files are large/external)
data/manual/**
!data/manual/.gitkeep
!data/manual/**/.gitkeep
data/cache/**
!data/cache/.gitkeep

# misc
.DS_Store
*.log

# handover artifacts (large DB dump kept out of git; ship separately)
handover/

# celery beat runtime state (regenerated; never commit)
backend/celerybeat-schedule*
