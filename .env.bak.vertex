
# ============================================================================
# BharathTax — web-app deployment (.env)
# Domain:  https://bharattax.wenvia.global
# LLM:     remote LiteLLM at https://bharattaxllm.wenvia.global/v1
# ml-server: SKIPPED (embedding/rerank endpoints will error until configured)
# ============================================================================

# ---- General ----
APP_ENV=prod
APP_NAME=BharathTax
LOG_LEVEL=INFO

# ---- Postgres (pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=taxmedha
POSTGRES_USER=taxmedha
POSTGRES_PASSWORD=329238e92d0f90b41cc7c7a7ac843342

# ---- Redis (Celery broker/result) ----
REDIS_URL=redis://redis:6379/0

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=eeb3bc5624d5edcba93864f296728ba9
MINIO_SECURE=false
MINIO_BUCKET_RAW=taxmedha-raw
MINIO_REGION=in-local

# ---- ML server (SKIPPED in this deployment) ----
# Set this only when you provide a remote embedding+rerank service.
ML_SERVER_URL=http://ml-server:8001
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ML_DEVICE=cpu

# ---- LLM serving via remote LiteLLM VPS ----
LLM_BACKEND=openai
LLM_MODEL_NAME=bharattax-rag                   # grounded RAG model (primary path)
LLM_FALLBACK_MODEL_NAME=llama-3.1-8b-instruct  # used when bharattax-rag refuses (no source found)
LLM_BASE_URL=http://host.docker.internal:14000/v1
LLM_API_KEY=sk-7dV_ihGGc2EsXA1CypqSyg
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ---- Retrieval tuning ----
RETRIEVAL_DENSE_K=20
RETRIEVAL_SPARSE_K=20
RETRIEVAL_RERANK_K=8
RETRIEVAL_MIN_SCORE=0.30

# ---- Auth / JWT / licensing ----
JWT_SECRET=9c530721427e082cc20367b99c230f6ab71b00fddc2fb5cf25c4afd2a51bd4a0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200       # 30 days; expired tokens auto-bounce the user to /login client-side
SEAT_LEASE_HEARTBEAT_SECONDS=120

# ---- Ingestion pipeline ----
SOURCES_CONFIG=/app/config/sources.yaml
MANUAL_DROP_DIR=/data/manual
CRAWL_CACHE_DIR=/data/cache
CRAWL_RATE_LIMIT_SECONDS=3
CRAWL_USER_AGENT=BharathTax-Ingest/0.1 (+internal government research tool)
INCREMENTAL_UPDATE_CRON=0 2 * * *

# ---- Frontend (baked into the bundle at build time) ----
VITE_API_BASE_URL=https://bharattax.wenvia.global/api

# ml-server embedding/rerank sequence caps
EMBED_MAX_LENGTH=256
RERANK_MAX_LENGTH=512
OO_JWT_SECRET=0ee6d969ef8858dd31fe5abd68b1ae76e94a83b4b16e095ff73ae0bffe5e81d2
GEMINI_API_KEY=AIzaSyA29nI1QoRggzhp6sxmmkiJ82GRLDmaVr4
GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-pro-latest
# JSON-mode extraction tier (Modules 1/2/3/4): 3-5x faster than Flash on
# structured classification. Falls back to GEMINI_MODELS if unset.
GEMINI_JSON_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-flash-latest
# OCR tier for uploaded appeal PDFs: cheapest tier since it is pure vision.
GEMINI_OCR_MODELS=gemini-flash-lite-latest,gemini-1.5-flash-8b
# Concurrent Gemini calls per worker process. Threads-pool Celery worker
# runs 12 tasks; each can fan out up to 6 issue-drafts under Module 5. A
# shared cap of 16 keeps us clear of Google's per-minute rate limit while
# letting a full case burst 12+ requests without queueing.
GEMINI_CONCURRENCY=16
# Fewer retries per model — with three models in the fallback chain, 2
# retries each is plenty; more just wastes wall clock when Google is down.
GEMINI_RETRIES=2
WEB_SEARCH_ENABLED=1
# Grounded web-search model. Bench (2026-08-03, this key):
#   gemini-3.5-flash    out=2500 no-thinking-cap → 14.7s, 18 sources, 3153 chars ← chosen
#   gemini-3.1-pro-preview no-cap                → 23.5s,  6 sources, 1804 chars (3× slower, fewer sources)
#   gemini-3.1-pro-preview thinkingBudget=512    → 47.4s, 3 sources (slowest — cap starves Pro)
# Flash 3.5 is BOTH the fastest AND the richest for grounded search on this
# key; Pro-preview is fallback only for quota-exhaustion days.
GEMINI_SEARCH_MODEL=gemini-3.5-flash
GEMINI_SEARCH_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-pro-preview
PROMPT_VERSION=appeal-2026.07.02
CORPUS_VERSION=itact-1961-2025

# ---- Cloudflare R2 (durable object storage — Phase 2 storage backend) ----
# Bucket location: Asia-Pacific (APAC). Speaks S3 protocol; the minio-py
# client can talk to it with SigV4.  ROTATE THESE after the initial wiring
# is confirmed working — they've been exposed via chat screenshots.
R2_ACCOUNT_ID=e463875afd46f7013d869719c51c22f8
R2_ACCESS_KEY_ID=286bfedb310c747a6ab295bd5c41ef7a
R2_SECRET_ACCESS_KEY=17d1bd79a55424e46bb01cbe43773c1a0e434c3f85d91e62c0952f771477f584
R2_BUCKET_RAW=bharattax-bucket
R2_ENDPOINT=e463875afd46f7013d869719c51c22f8.r2.cloudflarestorage.com
R2_REGION=auto
R2_SIGNED_URL_TTL_SECONDS=86400
# When 1, uploads land in BOTH MinIO and R2 during the migration window.
# Flip to 0 once R2 is confirmed the source of truth for a week.
R2_DUAL_WRITE=1
# 2500 is the sweet spot for gemini-3.5-flash — leaves room for ~900 thinking
# tokens + ~1600 answer tokens (measured ~3.1k chars, ~18 grounded sources).
# Larger caps let Flash 3.5 spend more time thinking (25-30s vs 14-15s at 2500).
GEMINI_SEARCH_MAX_OUTPUT=2500
# Cap Flash's thinking so it doesn't spend 1400 tokens deliberating a 3-line
# answer. 512 keeps grounded search around 9-11s per call while still producing
# a full answer + 10+ sources. Set to 0 or -1 to let the model auto-decide.
GEMINI_SEARCH_THINKING_BUDGET=512

CHAT_AGENT_ENABLED=1

# ---- SMTP (password-reset emails) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=wenviatech@gmail.com
SMTP_PASSWORD=pqvwzkqwykgejimg
SMTP_FROM=BharatTax Appeal Order <wenviatech@gmail.com>
PUBLIC_APP_URL=https://bharattax.wenvia.global

INDIANKANOON_API_TOKEN=723cff9e62328d61325a67a1b77f5eb27bdbac8f
