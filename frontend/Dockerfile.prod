# Multi-stage production build for the BharathTax web frontend.
# Stage 1: install deps + vite build into /app/dist
# Stage 2: serve dist via nginx-alpine on :80
FROM node:20-alpine AS build
WORKDIR /app

# Vite reads VITE_* env vars at build time and inlines them into the bundle.
# Pass with --build-arg VITE_API_BASE_URL=... in compose.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
