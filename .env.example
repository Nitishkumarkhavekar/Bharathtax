# ============================================================================
# BharathTax — environment configuration
# Copy to `.env` and adjust. NOTHING is hardcoded in source: URLs, model names,
# secrets, and source paths all live here. (Coding standard: config via env.)
# ============================================================================

# ---- General ----
APP_ENV=dev
APP_NAME=BharathTax
LOG_LEVEL=INFO
# Country/data-residency assertion is operational, not enforced in code here.

# ---- Postgres (pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=taxmedha
POSTGRES_USER=taxmedha
POSTGRES_PASSWORD=change-me-in-prod
# SQLAlchemy URL is composed from the parts above in core/config.py.

# ---- Redis (Celery broker/result) ----
REDIS_URL=redis://redis:6379/0

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=taxmedha-raw          # raw source + uploaded files
MINIO_REGION=in-local

# ---- ML server (self-hosted embeddings + reranker) ----
ML_SERVER_URL=http://ml-server:8001
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ML_DEVICE=cpu                          # cpu | cuda  (this laptop: cpu)

# ---- LLM serving (behind LLMClient abstraction; swap backend via env only) ----
# dev on a no-GPU laptop:  LLM_BACKEND=ollama  (small model)
# production GPU box:       LLM_BACKEND=vllm    (Qwen2.5-14B-Instruct)
# stack-boots-without-model: LLM_BACKEND=mock
LLM_BACKEND=mock
LLM_MODEL_NAME=qwen2.5:3b-instruct     # prod swap: Qwen/Qwen2.5-14B-Instruct
LLM_BASE_URL=http://host.docker.internal:11434/v1   # ollama default; vllm: http://llm:8000/v1
LLM_API_KEY=not-needed-for-local
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ---- Retrieval tuning ----
RETRIEVAL_DENSE_K=20                   # top-k from pgvector
RETRIEVAL_SPARSE_K=20                  # top-k from Postgres FTS
RETRIEVAL_RERANK_K=8                   # passages fed to the LLM after rerank
RETRIEVAL_MIN_SCORE=0.30               # below this => "no relevant source found"

# ---- Auth / JWT / licensing ----
JWT_SECRET=change-me-very-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480        # also the seat-lease TTL
SEAT_LEASE_HEARTBEAT_SECONDS=120       # client pings; reaper frees stale leases

# ---- Ingestion pipeline ----
SOURCES_CONFIG=/app/config/sources.yaml
MANUAL_DROP_DIR=/data/manual
CRAWL_CACHE_DIR=/data/cache
CRAWL_RATE_LIMIT_SECONDS=3             # polite: min seconds between requests/host
CRAWL_USER_AGENT=BharathTax-Ingest/0.1 (+internal government research tool)
INCREMENTAL_UPDATE_CRON=0 2 * * *      # nightly delta check (Celery beat)

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ml-server embedding/rerank sequence caps (CPU speed vs context)
EMBED_MAX_LENGTH=256
RERANK_MAX_LENGTH=512
